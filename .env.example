# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Production Postgres (Neon/Supabase/Railway). Leave empty to use the embedded
# PGlite database stored in ./.pglite (development only).
# DATABASE_URL=postgres://user:pass@host:5432/pixelspace

# SMTP for reset/verification emails. Leave empty in development — emails are
# captured in the dev mailbox at /api/dev/emails instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Pixelspace AI Classroom <no-reply@pixelspace.my>

# Enables the development mailbox API at /api/dev/emails (captures reset and
# verification links when SMTP is not configured). NEVER enable in production.
DEV_MAILBOX=1

# ---- AI generation (Pixelspace Router — OpenAI-compatible) ----
# Used for slide/text generation and illustration images.
# ROUTER_BASE_URL=https://router.example.com/v1
# ROUTER_API_KEY=
# MODEL_TEXT=gemini-2.5-flash
# MODEL_IMAGE=gemini-3.1-flash-image
# Local-only: fake generation without calling the router.
# GENERATION_MOCK=1

# Directory for generated artifact images (mounted volume in Docker).
# ASSETS_DIR=./.assets

# ---- Sources (Phase 1) ----
# TinyFish web search for the "Cari di web" source option.
# TINYFISH_API_KEY=
# Textbook knowledge base (books + chunks, pgvector Postgres).
# TEXTBOOK_DB_URL=postgresql://user:pass@host:5432/textbook_kb

# Source indexing (OpenAI-compatible embeddings endpoint). Uses the router by default.
MODEL_EMBEDDING=qwen3-vl-embedding-8b
# EMBEDDING_BASE_URL=https://your-embedding-router/v1
# EMBEDDING_API_KEY=
